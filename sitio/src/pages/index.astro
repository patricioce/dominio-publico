---
// Portada: el próximo 1 de enero (o el año con datos más cercano), según la fecha de compilación.
import PaginaAnio from '../components/PaginaAnio.astro';
import { autores } from '../lib/datos';
import { aniosConDatos } from '../lib/anios';

const proximo = new Date().getFullYear() + 1;
const anios = aniosConDatos(autores);
const anio = anios.find((a) => a >= proximo) ?? anios.at(-1)!;
---
<PaginaAnio anio={anio} />

---
// Layout común: encabezado con el logo y el menú numerado, aviso legal y pie.
// El slot "ancho" va antes del contenedor centrado, para piezas a todo el ancho (portada).
import '../styles/global.css';
import { url } from '../lib/rutas';

type Seccion = 'inicio' | 'anio' | 'autores' | 'metodo' | 'datos';

interface Props {
  titulo: string;
  descripcion?: string;
  seccion?: Seccion;
}

const { titulo, descripcion, seccion } = Astro.props;
const NOMBRE = 'En Dominio Público';

const proximo = new Date().getFullYear() + 1;
const enlaces: { id: Seccion; href: string; texto: string }[] = [
  { id: 'autores', href: url('/autores/'), texto: 'Autores' },
  { id: 'anio', href: url(`/anio/${proximo}/`), texto: `Se liberan en ${proximo}` },
  { id: 'metodo', href: url('/como-calculamos/'), texto: 'Cómo calculamos' },
  { id: 'datos', href: url('/calidad-de-datos/'), texto: 'Calidad de datos' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo} · {NOMBRE}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400;0,500;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href={url('/')} aria-label={`${NOMBRE}, inicio`}>En<br />Dominio<br />Público<i>.</i></a>
        <nav class="main" aria-label="Secciones">
          {enlaces.map((e, i) => (
            <a href={e.href} aria-current={e.id === seccion ? 'page' : undefined}>
              <span>{String(i + 1).padStart(2, '0')}</span>{e.texto}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <div class="notice">
      <div class="wrap">Información orientativa, no es asesoramiento legal. Los años se calculan según la ley argentina (vida + 70).</div>
    </div>

    <main>
      <slot name="ancho" />
      <div class="wrap"><slot /></div>
    </main>

    <footer>
      <div class="wrap">
        <p class="brand">En<br />Dominio<br />Público<i>.</i></p>
        <p>Información orientativa, no es asesoramiento legal. El cálculo aplica el plazo estándar; coautorías, obras póstumas, traducciones y marcas registradas pueden cambiarlo.</p>
        <p>En Argentina, el uso comercial de obras en dominio público paga un derecho al Fondo Nacional de las Artes (dominio público pagante).</p>
        <p>Datos: Wikidata (CC0), con correcciones y fichas curadas a mano. Retratos: Wikimedia Commons.</p>
      </div>
    </footer>
  </body>
</html>
